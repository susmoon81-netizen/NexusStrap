<ui:UiPage x:Class="NexusStrap.UI.Elements.AccountManagers.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dmodels="clr-namespace:NexusStrap.UI.ViewModels.AccountManagers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="560" d:DesignWidth="850"
      Title="Profile Page"
      Scrollable="True">

    <Grid Margin="4,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="Profile" />
            <ui:Button HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Content="Refresh" />
        </Grid>

        <!-- Loading -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Loading profile..." />
        </StackPanel>

        <!-- Empty / error -->
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{Binding LoadError}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoadError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding UserId}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Identity card -->
            <Border Margin="0,0,0,16" Padding="20,16" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#10FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness Left="3" Top="0" Right="0" Bottom="0" />
                </Border.BorderThickness>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <Border Width="110" Height="110" CornerRadius="14">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Clip>
                                <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,110,110" />
                            </Border.Clip>
                        </Border>
                        <Border Width="22" Height="22" Margin="0,0,4,4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{Binding PresenceColor}"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="3" CornerRadius="11"
                                ToolTip="{Binding PresenceText}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.6" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="14" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Username}" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal"
                                    Visibility="{Binding HasCounts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Padding="8,3" CornerRadius="5" Margin="0,0,8,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.15" />
                                </Border.Background>
                                <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding FriendsCount, StringFormat='{}{0} Friends'}" />
                            </Border>
                            <Border Padding="8,3" CornerRadius="5" Margin="0,0,8,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.15" />
                                </Border.Background>
                                <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding FollowersCount, StringFormat='{}{0} Followers'}" />
                            </Border>
                            <Border Padding="8,3" CornerRadius="5">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.15" />
                                </Border.Background>
                                <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding FollowingCount, StringFormat='{}{0} Following'}" />
                            </Border>
                        </StackPanel>
                        <Border Margin="0,10,0,0" Padding="8,4" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ID" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding UserIdText}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" VerticalAlignment="Center" />
                                <ui:Button Width="26" Height="26" Padding="0" Margin="8,0,0,0"
                                           Appearance="Secondary" Command="{Binding CopyIdCommand}" ToolTip="Copy ID">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="13" />
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status / game card -->
            <Border Padding="16" Background="{DynamicResource PrimaryBackgroundColor}"
                    BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Background="{Binding PresenceColor}" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PresenceText}" />
                        </StackPanel>
                        <TextBlock Margin="18,4,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding LocationText}" TextWrapping="Wrap"
                                   Visibility="{Binding IsInGame, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                               Appearance="Primary" Command="{Binding JoinUserCommand}" Content="Join Server"
                               Visibility="{Binding IsInGame, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left"
                       Command="{Binding OpenRobloxPageCommand}" Content="View on Roblox" Icon="Globe24" />
        </StackPanel>
    </Grid>
</ui:UiPage>
